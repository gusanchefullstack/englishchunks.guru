# Cloud Run variant of ./Dockerfile: same Python deps and code, but the int8 ONNX models are
# baked into the image (Cloud Run has no host volume to mount them from) and the server listens
# on Cloud Run's $PORT. Build context: see RUNBOOK "Cloud Run" (repo files + scoring/models).
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends espeak-ng libespeak-ng1 \
 && rm -rf /var/lib/apt/lists/*

# Models early: the biggest layer changes least often, so code changes reuse it from cache.
# Root-owned, so read-only to the app user.
COPY scoring/models /models

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1

WORKDIR /app
COPY scoring/pyproject.toml scoring/uv.lock scoring/README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY scoring/src ./src
COPY web/src/content/sound-hints.json /app/web/src/content/sound-hints.json
RUN uv sync --frozen --no-dev

ENV MODELS_DIR=/models \
    SOUND_HINTS_PATH=/app/web/src/content/sound-hints.json
RUN useradd --system --uid 10001 scoring
USER scoring
# Cloud Run injects PORT (default 8080). /healthz returns 503 until the models are loaded, so the
# startup probe holds traffic until the instance can score.
CMD exec /app/.venv/bin/uvicorn scoring.app:app --host 0.0.0.0 --port "${PORT:-8080}" --workers 1 --no-access-log
