# Copy to .env.local and fill in locally. NEVER commit real values (constitution IV).

# Database (Neon Postgres)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth (Better Auth)
BETTER_AUTH_SECRET=replace-with-32+-random-chars
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (Vercel AI Gateway — open-weight models)
AI_GATEWAY_API_KEY=
AI_FEEDBACK_MODEL=google/gemma-4-26b-a4b-it
AI_AUDIT_MODEL=openai/gpt-oss-20b

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Object storage (DigitalOcean Spaces)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=https://<bucket>.nyc3.cdn.digitaloceanspaces.com

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="EnglishChunks.guru <hello@englishchunks.guru>"

# Scoring service
SCORING_URL=http://localhost:8001
SCORING_SHARED_SECRET=replace-with-32+-random-chars

# Cron + unsubscribe signing
CRON_SECRET=replace-with-32+-random-chars
UNSUBSCRIBE_SECRET=replace-with-32+-random-chars

# Billing (Stripe) — test-mode keys only until go-live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
